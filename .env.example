# ==============================================
# Buildora Environment Configuration Example
# ==============================================

NODE_ENV=development

# Next.js talks to its own Route Handlers by default.
NEXT_PUBLIC_API_URL="/api"

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=buildora
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/buildora?schema=public"

# Mistral AI
MISTRAL_API_KEY=""
MISTRAL_MODEL="mistral-small-latest"

# S3 / MinIO Object Storage (optional for hackathon demo)
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL_BASE=""
S3_FORCE_PATH_STYLE="true"
