# ==============================================
# Buildora Environment Configuration Example
# ==============================================

# Node / Bun Environment
NODE_ENV=development
PORT=4000
WEB_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=buildora
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/buildora?schema=public"

# Authentication & Security
JWT_ACCESS_SECRET="buildora_dev_jwt_access_secret_min_32_characters_long_12345"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN_DAYS=7

# Mistral AI (Called only from NestJS API)
MISTRAL_API_KEY=""
MISTRAL_MODEL="mistral-small-latest"

# S3 / MinIO Object Storage (Optional; all-or-none validation when configured)
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL_BASE=""
S3_FORCE_PATH_STYLE="true"
